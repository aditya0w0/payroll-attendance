# Database Connection URL (SQLite default for zero-config local run; for Postgres: postgresql://user:pass@localhost:5432/payroll)
DATABASE_URL="file:./dev.db"

# Session Security & Encryption Key
SESSION_SECRET="payroll_qr_attendance_super_secret_session_key_2026_idr"

# Authoritative Business Timezone
NEXT_PUBLIC_TIMEZONE="Asia/Jakarta"

# WebAuthn / Passkey Relying Party Configuration (Production Vercel)
# RP_ID="payroll.yourcompany.com"
# EXPECTED_ORIGIN="https://payroll.yourcompany.com"
# STRICT_SINGLE_DEVICE_SYNC_POLICY="ALLOW_WITH_FLAG" # "ALLOW_WITH_FLAG" | "BLOCK_SYNCED"

# Cryptographic Audit Hash-Chain Signing Keys (Ed25519)
# Generate via: node scripts/generate-audit-keys.js
AUDIT_SIGNING_PRIVATE_KEY=""
AUDIT_SIGNING_PUBLIC_KEY=""

# Vercel Cron Secret for Scheduled Outbox Dispatch
CRON_SECRET="generate_a_secure_random_cron_secret"

# S3 / Cloudflare R2 Archive Sink (Optional for WORM retention)
# S3_ARCHIVE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ARCHIVE_BUCKET="payroll-audit-worm"
# S3_ARCHIVE_REGION="auto"
# S3_ARCHIVE_ACCESS_KEY_ID=""
# S3_ARCHIVE_SECRET_ACCESS_KEY=""
# S3_ARCHIVE_OBJECT_LOCK="false" # "true" to enforce S3 Object Lock retention headers
